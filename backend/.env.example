# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:////data/db.sqlite3

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Storage ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=/data/uploads
RESULTS_DIR=/data/results
MAX_UPLOAD_SIZE_MB=1024

# ─── Server ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins. Use "*" for development only.
CORS_ORIGINS=*

# ─── Processing ──────────────────────────────────────────────────────────────
# Maximum iterations for 3DGS training. Higher = better quality, slower.
# Quick test: 5000  |  Good quality: 30000  |  Best quality: 60000
NERFSTUDIO_MAX_ITERATIONS=30000

# COLMAP GPU SIFT. Leave at 0 (CPU) unless you replaced the bundled Ubuntu
# COLMAP package with a CUDA-enabled build — the apt package is CPU-only and
# GPU SIFT also needs an OpenGL context that headless containers lack.
COLMAP_USE_GPU=0
# GPU index used when COLMAP_USE_GPU=1 (-1 = all GPUs)
COLMAP_GPU_INDEX=0

# ─── Notifications (optional) ────────────────────────────────────────────────
# APNs push notification key for iOS job-complete alerts (leave blank to disable)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.scancapture.app
APNS_KEY_PATH=/run/secrets/apns_key
